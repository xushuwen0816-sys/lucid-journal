generator client {
  provider = "prisma-client-js"
}

// NOTE: Provider is set dynamically by scripts/check-provider.js
// Default is set to postgresql to satisfy git tracking for production
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  name         String?
  apiKey       String?
  proxyUrl     String?
  provider     String?  @default("gemini")
  
  wishes       Wish[]
  journals     JournalEntry[]
  rituals      RitualArchiveEntry[]
  letters      FutureLetter[]
}

model Wish {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  content       String
  createdAt     DateTime @default(now())
  status        String   
  
  tags          String   
  deepDiveChat  String   
  beliefs       String   
  affirmations  String   
}

model JournalEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime
  content      String
  
  aiAnalysis   String?  
}

model RitualArchiveEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime
  
  reading      String?  // JSON: TarotReading
  oracleReading String? // JSON: OracleReading
  practice     String?  // JSON: DailyPractice
}

model FutureLetter {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  content      String
  sendDate     DateTime
  aiReply      String?
  isLocked     Boolean
  isSent       Boolean  @default(false)
}
